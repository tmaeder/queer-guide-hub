  "narrative": {
    "northStar": "Paper, ink, and subway wayfinding",
    "overview": "This scoped record extends the incumbent queer.guide world: restrained editorial type, warm paper, dark operational controls, and the existing subway ground. Invitation review, email choices, and saved searches remain ordinary parts of their existing homes. They introduce no competing identity.\n\nThe interface is quiet and direct. Text explains what an action does; tonal controls distinguish the next step. The invitation name stays readable before its review action, and delivery availability appears with the preference it qualifies.",
    "keyCharacteristics": [
      "Paper and ink with inherited tonal controls.",
      "Clear section hierarchy and explicit action labels.",
      "Wrapping content with recoverable inline states."
    ],
    "rules": [
      {
        "name": "The Meaning Before Color Rule",
        "body": "Explain delivery availability and invitation state in text; color does not carry that meaning alone.",
        "section": "colors"
      },
      {
        "name": "The Explicit Next Step Rule",
        "body": "Review, saving a preference, and receiving email must remain distinguishable in action labels and nearby copy.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** reuse semantic paper/ink variables, shared buttons, and existing type roles.",
      "**Do** let long invitation names and control groups wrap without hiding their meaning.",
      "**Do** keep availability, recovery, and focus treatment visible at the point of action.",
      "**Do** preserve independent opt-ins and ordinary labeled controls."
    ],
    "donts": [
      "**Don't** introduce a new palette, card system, or imagery for these operational sections.",
      "**Don't** label saved alert preferences as active email delivery.",
      "**Don't** make viewing the invitation list imply joining a group.",
      "**Don't** promote fixture captions or a fixture's outer layout into product design rules."
    ]
  }
