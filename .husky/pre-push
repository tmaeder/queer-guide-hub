# Migration guards. Both failure modes make `supabase db push` skip SILENTLY —
# nothing deploys and no workflow goes red — so catch them before the push.
#   check-migration-versions: duplicate / malformed 14-digit versions (pure local)
#   check-migration-drift:    versions already applied to prod with no repo file
# 1 = a confirmed problem (duplicate/malformed, or an ordering violation proven
# NOT already applied), block. 2 = could not verify against remote history (no
# token / API down) — warn, same contract as the drift check below.
ver=0
node scripts/check-migration-versions.mjs || ver=$?
if [ "$ver" -eq 1 ]; then
  exit 1
fi

# husky runs hooks under `sh -e`, so a bare non-zero exit here would abort the
# hook before the exit code is inspected. `|| drift=$?` keeps it in an || list.
drift=0
node scripts/check-migration-drift.mjs || drift=$?
# 1 = real drift, block. Anything else (no SUPABASE_ACCESS_TOKEN, Management API
# unreachable, no git baseline) means the check could not fully run — the degraded
# merge-base check has already reported, so warn rather than block the push.
if [ "$drift" -eq 1 ]; then
  exit 1
fi

# Lint ONLY what this push changes.
#
# This was `npm run lint` — `eslint .` over the whole repo. Measured on a real
# checkout 2026-09-02: 1.5-2h per run, ~11 min of CPU against ~2h of wall clock,
# i.e. I/O-bound rather than compute-bound, with three concurrent runs (one per
# pushing worktree) livelocking each other. `git push` sat at 0.04s CPU for ten
# minutes with no pack-objects child, looking exactly like a network hang — the
# hook is the last place you think to look, so it cost a full session to find.
#
# The real cost was not the time. A guard nobody can afford to run gets
# bypassed: every push that day went out with --no-verify, so the practical
# effect of the full-repo lint was NO lint at all. A fast partial check that
# actually runs beats a thorough one that gets skipped.
#
# Safe to narrow because ESLint is per-file — this config has no cross-file
# rules, so linting the pushed diff gives the same verdict for the files that
# changed. Whole-repo coverage is not lost, it moves off the critical path: CI
# runs `eslint .` on every PR (the `lint` required check), which is where a
# violation in an UNTOUCHED file would have to surface anyway, since this hook
# only ever ran on push.
#
# PREPUSH_FULL_LINT=1 restores the old behaviour.
if [ "${PREPUSH_FULL_LINT:-0}" = "1" ]; then
  npm run lint
else
  # What is being pushed = this branch vs where it forked from the base. Reads
  # the LOCAL origin/main ref and never fetches, so the hook stays offline-safe.
  base=$(git merge-base HEAD origin/main 2>/dev/null || true)
  if [ -z "$base" ]; then
    echo "pre-push: no origin/main to diff against — skipping lint (CI runs eslint . on the PR)"
    exit 0
  fi

  # ACMR excludes deletions: eslint exits non-zero on a path that no longer exists.
  files=$(git diff --name-only --diff-filter=ACMR "$base"...HEAD -- \
    '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' 2>/dev/null || true)

  if [ -z "$files" ]; then
    echo "pre-push: no lintable files in this push — skipping lint"
  else
    n=$(printf '%s\n' "$files" | wc -l | tr -d ' ')
    echo "pre-push: linting $n changed file(s) (PREPUSH_FULL_LINT=1 for the whole repo)"
    # --no-warn-ignored: a changed file that eslint ignores is not an error.
    printf '%s\n' "$files" | xargs npx eslint --no-warn-ignored
  fi
fi
