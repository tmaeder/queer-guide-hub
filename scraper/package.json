{
  "name": "queer-guide-scraper",
  "version": "1.0.0",
  "description": "Production-grade scraping system for LGBTQ+ venue, event, and place listings",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "sync": "tsx scripts/gaycities-sync.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion@>=5.0.0 <5.0.6": "^5.0.6",
    "undici": "^7.29.0"
  }
}
