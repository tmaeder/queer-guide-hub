# Copy to /volume1/docker/translator/.env on the NAS and `chmod 600 .env`.
# Never commit the real file.
SUPABASE_URL=https://xqeacpakadqfxjxjcewc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Local hours (TZ below) when only demand jobs (priority >= QUIET_MIN_PRIORITY) run;
# backfill waits for the rest of the day.
QUIET_HOURS=07-23
QUIET_MIN_PRIORITY=50
# The worker waits while the NAS has less than this much MemAvailable.
MIN_MEM_AVAILABLE_MB=3072
TZ=Europe/Zurich
