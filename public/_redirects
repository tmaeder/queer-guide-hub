# Redirect old paths to /tags (canonical)
/ressources  /tags  301
/ressources/*  /tags/:splat  301
/resources  /tags  301
/resources/*  /tags/:splat  301

# /news/:slug is a first-class SPA detail page again (the P1.2 410 Gone
# handler at functions/news/[slug].ts was removed). The SPA renders it and
# functions/_middleware.ts injects crawler head/meta.

# P1.5 redirect removed 2026-05-24: /places revived as the editorial Atlas
# (cover destination + passport layer + editor rails). The SPA handles it.
# Sub-paths still redirect to /city for legacy compatibility — old /places/:slug
# style links pointed at city slugs.
/places/*  /city/:splat  301

# Plural detail URLs sometimes leak in from external links / hand-typed
# URLs. React Router only has singular detail routes (/city/:slug,
# /country/:slug) — redirect plurals so they don't render the SPA 404.
/cities/:slug    /city/:slug    301
/countries/:slug /country/:slug 301

# /help is the canonical crisis hub; /help-hotlines is the legacy URL and
# was never a React Router route, so it rendered the SPA 404 — on the one
# page where that is least acceptable. It still has inbound links (and the
# edge HTML in functions/_lib/ linked to it until 2026-08-01), so redirect
# rather than drop it.
/help-hotlines   /help          301

# Asset paths get a real 404 when missing. Without these rules the SPA
# catch-all below returns index.html (200 text/html) for any unmatched
# /assets/* path — and stale browser sessions whose cached bundle still
# references an old chunk hash then try to import that HTML as JS and
# blow up with "Failed to load module script: text/html MIME". CF Pages
# tries the static file first; these rules only fire when no file exists.
# DO NOT add identity rewrites like `/sw.js /sw.js 200` here — they
# create infinite rewrite loops that abort CF rule parsing entirely
# (breaks the SPA catch-all below, every route returns 404).
/assets/*  /404.html  404
/icons/*   /404.html  404
/fonts/*   /404.html  404
/locales/*  /404.html  404

# Cloudflare Pages SPA catch-all (must be last).
#
# DO NOT change the target to `/`. A 200-rewrite to `/` takes precedence over
# static-asset serving in CF Pages, so EVERY path — /robots.txt, /build-id.txt,
# and every hashed /assets/**.js — is served this HTML instead of the real
# file. The JS then fails strict MIME checking and the SPA never boots: the
# whole site returns 200 and renders a blank page. Tried and reverted on
# 2026-08-01 (#2469 -> this revert).
/*    /index.html   200
