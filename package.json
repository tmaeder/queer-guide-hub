    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "fflate": "0.8.3",
    "html-to-image": "^1.11.13",
    "i18next": "^26.4.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.3",
    "jpeg-js": "0.4.4",
    "jsqr": "1.4.0",
