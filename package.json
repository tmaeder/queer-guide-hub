{
  "name": "queer-guide",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/check-env.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:pages-routing": "node scripts/check-pages-routing.mjs",
    "prebuild": "tsx scripts/sync-public-locales.ts --write && node scripts/check-pages-routing.mjs",
    "build": "vite build",
    "build:check": "tsx scripts/sync-public-locales.ts --write && npm run typecheck && node --max-old-space-size=8192 node_modules/vite/bin/vite.js build && node scripts/check-bundle-shape.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "knip": "knip",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "preview": "vite preview",
    "prerender": "node scripts/prerender.mjs",
    "typecheck": "node scripts/typecheck-ratchet.mjs",
    "typecheck:functions-tests": "tsc -p tsconfig.functions-tests.json --noEmit",
    "typecheck:functions": "tsc -p tsconfig.functions.json --noEmit && tsc -p tsconfig.functions-tests.json --noEmit",
    "typecheck:baseline": "node scripts/typecheck-ratchet.mjs --write",
    "test": "vitest run",
    "test:merge-policy": "tsx scripts/test-merge-gap-policy.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:functions": "cd supabase/functions && deno test --allow-net --allow-env --allow-read --node-modules-dir=none",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "bones": "boneyard build",
    "bones:force": "boneyard build --force",
    "gates": "node scripts/check-data-quality-gates.mjs",
    "i18n:check": "node scripts/check-i18n-duplicate-keys.mjs && node scripts/check-copy-vocabulary.mjs && tsx scripts/sync-translations.ts && node scripts/check-i18n-placeholders.mjs && tsx scripts/sync-public-locales.ts --check",
    "i18n:baseline": "node scripts/check-i18n-placeholders.mjs --write",
    "i18n:check:defaults": "node scripts/check-i18n-german-defaults.mjs",
    "i18n:check:dupes": "node scripts/check-i18n-duplicate-keys.mjs",
    "i18n:fill": "tsx scripts/sync-translations.ts --fill",
    "i18n:sync": "tsx scripts/sync-public-locales.ts --write",
    "verify:gh-sync": "tsx scripts/verify-github-sync.ts",
    "prepare": "husky",
    "test:merchant-sync": "vitest run --config tests/merchant-sync/vitest.config.ts",
    "test:redirect-import": "node scripts/test-redirect-import.mjs",
    "test:redirect-sql": "node scripts/test-redirect-platform-sql.mjs",
    "test:redirect-subpath": "node scripts/test-redirect-subpath.mjs",
    "test:redirect-roots": "node scripts/test-redirect-root-links.mjs",
    "test:redirect-stripe": "node scripts/test-redirect-stripe.mjs",
    "test:redirect-sdks": "node scripts/test-redirect-sdks.mjs",
    "test:redirect-integrations": "node scripts/test-redirect-integrations.mjs",
    "test:redirect-webhooks": "node scripts/test-redirect-webhooks.mjs",
    "test:redirect-qr": "node scripts/test-redirect-qr-worker.mjs",
    "test:redirect-manifest": "node scripts/sync-redirect-inventory-manifest.mjs"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "src/**/*.{css,json}": [
      "prettier --write"
    ]
  },
