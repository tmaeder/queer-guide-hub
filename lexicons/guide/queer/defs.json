{
  "lexicon": 1,
  "id": "guide.queer.defs",
  "defs": {
    "subject": {
      "type": "object",
      "description": "A Queer Guide page: a venue, event, city or country.",
      "required": ["uri", "type"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "description": "Canonical https://queer.guide URL of the page." },
        "type": { "type": "string", "knownValues": ["venue", "event", "city", "country"] },
        "title": { "type": "string", "maxLength": 300 }
      }
    }
  }
}
