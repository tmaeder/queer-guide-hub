{
  "lexicon": 1,
  "id": "guide.queer.review",
  "defs": {
    "main": {
      "type": "record",
      "description": "The author's rating of a venue. One per subject; the record key is derived from the subject.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["subject", "rating", "createdAt"],
        "properties": {
          "subject": { "type": "ref", "ref": "guide.queer.defs#subject" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
          "text": { "type": "string", "maxLength": 3000, "maxGraphemes": 1000 },
          "createdAt": { "type": "string", "format": "datetime" }
        }
      }
    }
  }
}
