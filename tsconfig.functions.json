/*
 * Typecheck for the Cloudflare Pages Functions bundle.
 *
 * Why this exists: `functions/` was in NO tsconfig include. `tsconfig.app.json`
 * covers `["src"]` only, and `functions/_middleware.ts` is additionally in the
 * ESLint ignore list. So the edge code — which claims `/*`, and is also the SPA
 * fallback, the asset-404 converter, the CSP nonce stamper and the security
 * header applier — shipped with no static checking at all. A broken import there
 * passes CI green and fails at request time in production.
 *
 * `coverage.include` in vite.config.ts is `src/**` only, so tests do not cover
 * this tree either. This config is the only gate it has.
 *
 * Note the module resolution differs from the app: Pages Functions are bundled
 * by esbuild with no `@/` alias, which is why shared modules imported from
 * `src/` must use relative paths and stay dependency-free (see
 * src/lib/databaseBlock/schema.ts and its portability test).
 */
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["functions/**/*.ts"]
}
