# Supabase
# NOTE: the app's own client (src/integrations/supabase/client.ts) HARDCODES the
# project URL + anon key, so auth and every normal query work without these vars.
# They are only read by src/hooks/useMailbox.ts (apikey header), ShareTripDialog,
# tools/person-db, the extension, and scripts/. A wrong value here surfaces as
# HTTP 401 {"message":"Invalid API key"} on those paths only — it does NOT log
# you out. Note scripts/check-env.mjs only rejects empty / "your-" values, so a
# junk placeholder passes the predev gate silently.
#
# Fetch the current key for project xqeacpakadqfxjxjcewc with either:
#   supabase projects api-keys --project-ref xqeacpakadqfxjxjcewc
# or the Supabase MCP tool `get_publishable_keys` (entry named "anon").
# Use the legacy "anon" JWT (eyJ...) — that is what the hardcoded client and the
# extension defaults expect. The modern sb_publishable_... key also authenticates,
# but keep the two formats consistent across the repo.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Search
VITE_SEARCH_PROXY_URL=https://your-search-proxy.workers.dev

# AI assistant (conversational concierge worker)
VITE_ASSISTANT_URL=https://assistant.queer.guide

# Maps
VITE_BASEMAP_ASSETS_URL=https://your-basemap-assets.example.com

# Cloudflare Turnstile (CAPTCHA on auth forms).
# PUBLIC site key — must match the secret key configured in the Supabase
# dashboard (Authentication → Bot & Abuse Protection → Cloudflare Turnstile).
# Required in production because Supabase Auth rejects sign-in / sign-up /
# password-reset requests without a captcha token. Leave empty to disable the
# widget locally (only works if CAPTCHA is also disabled in Supabase).
VITE_TURNSTILE_SITE_KEY=

# Invisible Turnstile widget for the "Ask the guide" assistant (anti-abuse on
# the public 70B endpoint). Separate widget/key pair from the auth one above;
# the matching secret lives on the assistant worker as TURNSTILE_SECRET.
VITE_TURNSTILE_ASSISTANT_SITE_KEY=

# Sentry (optional)
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=

# Web Push (optional)
VITE_VAPID_PUBLIC=

# Feature flags (optional) — set to 'off' to hide the trip context bar
VITE_TRIP_CONTEXT_BAR=

# Affiliate (Travelpayouts). All optional — sensible defaults baked into
# src/lib/affiliate/config.ts. Override only for staging/test accounts.
VITE_TRAVELPAYOUTS_MARKER=452012
VITE_BOOKING_AID=2381426
VITE_GYG_PARTNER=2PBDXWH
# Unset partner ids (EU transport) — links degrade gracefully without them:
VITE_OMIO_PARTNER_ID=
VITE_TRAINLINE_PARTNER_ID=
VITE_FLIXBUS_AWIN_ID=
