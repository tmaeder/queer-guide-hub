node_modules/
*.log
.wrangler/
.dev.vars
.env
dist/
coverage/
.DS_Store
tmp/
/tmp/*
!tmp/.gitkeep

# Spreadsheets + binary data dumps (imported into DB, not source code)
*.xlsx
*.xls
*.csv
*.numbers

# Reference dumps + source data artifacts
*.xml
*.ics
*.docx
*.rtf
*.pptx
# Root-only screenshots left behind by agent sessions. Every root-level image
# in this repo's history has been a stray (brand-prod.png, the home-*/map-*/
# prod-map-*/search-* dumps) and every one was removed again in a later chore
# commit — there has never been a legitimate image at the repo root. Anchored
# so real assets under public/, src/ and the Playwright *-snapshots/ dirs are
# untouched; add a `!/name.png` negation if a root image ever becomes real.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp

# Root-only txt/json dumps (keep nested ones for real code)
/*.txt
/*.json
!/design-sync.config.json
# Root tsconfigs are real code. The existing ones only survive `/*.json`
# because they were tracked before that rule landed — a NEW one is silently
# ignored, so CI would run `tsc -p` against a file that never ships.
!/tsconfig*.json

# Local workspaces + tool outputs
.claude/
.gstack/
.gstack-audit/
Dev/

# Supabase CLI local cache
supabase/.temp/

# Asset staging dirs
# Root-anchored: macOS sets core.ignorecase=true, so a bare `Icons/` also
# matched the real, shipped `public/icons/` and `extension/icons/` — the
# existing files there only survive because they predate the rule, while a
# NEW pwa/extension icon was silently dropped by `git add -A`.
/Icons/
!public/icons/
!extension/icons/
!src/components/icons/
stich/
Queer Guide/

# Legacy worker directories (migrated to workers/)
worker/
worker-ingest/
worker-submit/

# Playwright MCP session artifacts (console logs, page snapshots)
.playwright-mcp/

# Playwright test output (HTML reports, traces, last-run state)
playwright-report/
test-results/
# Playwright visual baselines are generated on CI (linux). A local macOS
# run writes *-darwin.png beside them, which must never be committed —
# CI would ignore them and reviewers would see phantom binary churn.
*-darwin.png

# Bundle visualizer output (vite rollup-plugin-visualizer, enabled via BUNDLE_STATS=1)
bundle-baselines/
scripts/output/

# design-sync (claude.ai/design converter scratch)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
# Root-anchored (`--declarationDir types` runs from the repo root). A bare
# `types/` also matched `src/types/` and `scraper/src/types/` — real source
# whose existing files only survive because they predate the rule.
/types/
/index.d.ts

# Local test-user credentials (not for commit)
.claude-test-user.json
node_modules
playwright/.auth/

# Drag Race import scrape cache/output (regenerable)
scripts/data-quality/out-dragrace/
graphify-out/
out-spartacus/
out-patroc/
out-swiss-events/
out-testfinder/
