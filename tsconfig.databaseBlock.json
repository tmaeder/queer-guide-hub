/*
 * Scoped, ACTUALLY-ENFORCED typecheck for the database-block feature.
 *
 * Why this file exists: `npm run typecheck` checks the whole app but only fails
 * on errors NEW relative to scripts/typecheck-baseline.json (~1400 pre-existing
 * errors, mostly Supabase type-inference noise). This config is the
 * zero-tolerance gate — CI runs it separately as `npm run typecheck:blocks`, so
 * these directories must have no errors at all, not merely no new ones.
 *
 * Widen `include` as the feature grows. Do not add pre-existing directories
 * without fixing their errors first — this gate must stay green.
 */
{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/lib/databaseBlock/**/*",
    "src/lib/cms/sanitizeCmsHtml.ts",
    "src/components/content/**/*",
    "src/components/cms/blocks/**/*",
    "src/components/cms/editor/extensions/**/*",
    "src/hooks/useEntityCards.ts"
  ]
}
